st.divider()
st.subheader("🚘 AI vehicle detection")
st.caption("Separate YOLO pass for cars, motorcycles, buses and trucks. This is a sampled-video prototype; counts are not a calibrated traffic sensor.")
vehicle_video = st.file_uploader("Upload road / intersection footage", type=["mp4", "avi", "mov", "mkv"], key="ps06_vehicle_video")
if vehicle_video is not None:
    if st.button("Run AI vehicle detection", type="primary", key="ps06_run_vehicle_detection"):
        temp_vehicle_path = None
        vehicle_cap = None
        try:
            import cv2
            import tempfile
            from ultralytics import YOLO
            suffix = "." + vehicle_video.name.rsplit(".", 1)[-1] if "." in vehicle_video.name else ".mp4"
            with tempfile.NamedTemporaryFile(delete=False, suffix=suffix) as tmp:
                tmp.write(vehicle_video.getbuffer())
                temp_vehicle_path = tmp.name
            vehicle_cap = cv2.VideoCapture(temp_vehicle_path)
            if not vehicle_cap.isOpened():
                raise RuntimeError("Could not open the uploaded road video.")
            model = YOLO("yolov8n.pt")
            total_frames = int(vehicle_cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
            fps = float(vehicle_cap.get(cv2.CAP_PROP_FPS) or 0)
            sample_step = max(1, int(fps * 0.5)) if fps > 0 else 12
            frame_idx = 0
            processed = 0
            peak_vehicles = 0
            vehicle_class_names = {2: "Car", 3: "Motorcycle", 5: "Bus", 7: "Truck"}
            class_totals = {v: 0 for v in vehicle_class_names.values()}
            annotated_preview = None
            progress = st.progress(0.0, text="Loading vehicle detector…")
            max_samples = max(1, min(240, total_frames // sample_step + 1)) if total_frames else 240
            while processed < max_samples:
                ok, frame = vehicle_cap.read()
                if not ok:
                    break
                if frame_idx % sample_step == 0:
                    results = model.track(frame, persist=True, classes=[2, 3, 5, 7], conf=0.30, verbose=False)
                    result = results[0]
                    boxes = result.boxes
                    counts = {v: 0 for v in vehicle_class_names.values()}
                    if boxes is not None and len(boxes) > 0:
                        for cls_id in boxes.cls.cpu().numpy().astype(int).tolist():
                            if cls_id in vehicle_class_names:
                                counts[vehicle_class_names[cls_id]] += 1
                    for name, count in counts.items():
                        class_totals[name] += count
                    peak_vehicles = max(peak_vehicles, sum(counts.values()))
                    if annotated_preview is None:
                        annotated_preview = result.plot()
                    processed += 1
                    if total_frames:
                        progress.progress(min(1.0, frame_idx / max(1, total_frames)), text=f"Analyzing sampled frames · {processed} processed")
                frame_idx += 1
            progress.empty()
            if annotated_preview is not None:
                v1, v2 = st.columns([1.5, 1])
                with v1:
                    st.image(cv2.cvtColor(annotated_preview, cv2.COLOR_BGR2RGB), caption="Annotated sample frame", width="stretch")
                with v2:
                    st.metric("Peak vehicles in a sampled frame", peak_vehicles)
                    st.metric("Frames analyzed", processed)
                    st.dataframe(pd.DataFrame([{"Vehicle class": k, "Detections across sampled frames": v} for k, v in class_totals.items()]), hide_index=True, width="stretch")
                st.caption("Class totals count detections across sampled frames; the same vehicle may be counted repeatedly. Peak vehicles is the maximum simultaneous count in one sampled frame.")
            else:
                st.warning("No vehicle detections were produced. Try a clearer road video with vehicles visible.")
        except Exception as vehicle_exc:
            st.error(f"Vehicle detection failed: {vehicle_exc}. Ensure ultralytics and OpenCV are installed and model weights can be loaded.")
        finally:
            if vehicle_cap is not None:
                vehicle_cap.release()
